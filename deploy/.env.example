POSTGRES_PASSWORD=
WEB_PORT=15173
API_PORT=18000
# N8N（docker compose --profile n8n up -d）：至少 24 字元的隨機字串，例如 python -c "import secrets;print(secrets.token_urlsafe(32))"
PF_N8N_TOKEN=
PF_PUBLIC_URL=http://127.0.0.1:15173
# 收件匣與備份資料夾（主機路徑；預設 deploy/inbox、deploy/backups）
PF_INBOX_HOST=./inbox
PF_BACKUP_HOST=./backups
