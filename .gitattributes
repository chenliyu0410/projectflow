# The demo data pack is verified by SHA-256 on restore, so Git must keep its bytes unchanged.
deploy/demo-data/** -text
# Preserve the imported fixture bytes, including CRLF and intentional final blank lines.
deploy/rag-starter/** -text whitespace=cr-at-eol,-blank-at-eof
# cmd.exe needs CRLF batch files; a clone must not turn them into LF.
*.bat text eol=crlf
# Portable demo documents are uploaded as-is; keep their bytes identical on every clone.
deploy/portable/demo-docs/** -text
# The AI demo pack is verified by SHA-256 on import; keep its bytes unchanged.
deploy/ai-demo-data/pack/** -text
# OCR samples and their labels are scored byte-for-byte; keep them identical on every clone.
deploy/ocr-eval/samples/** -text
# sha256sum -c on Linux needs LF lines.
*.sha256 text eol=lf
